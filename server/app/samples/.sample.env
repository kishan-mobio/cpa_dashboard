# Environment
NODE_ENV=development

# Server Configuration
PORT=3003
LOCAL_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_SQL_USER=your_username
DB_SQL_PASSWORD=your_password
DB_SQL_DATABASE=your_database_name
DB_CONNECTION_NAME=your_database_type_name
DB_TYPE=mongodb
DB_PORT=3306

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/test
MONGODB_DATABASE_NAME=test
TEST_DB_URL=mongodb://127.0.0.1:27017/test

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiter Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Timeout Configuration
TIMEOUT=5000

# SSO Authentication
## Auth0
SSO_CLIENT_ID=your_client_id
SSO_CLIENT_SECRET=your_client_secret
SSO_ISSUER=your_SSO_ISSUER
SSO_REDIRECT_URI=http://localhost:3003/api/v1/auth0/callback

## Azure AD
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_REDIRECT_URI=http://localhost:3003/api/v1/sso/callback
AZURE_BASE_URL=https://login.microsoftonline.com
AZURE_SCOPE=https://graph.microsoft.com/.default

## Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_domain
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# SSO Type
SSO_TYPE=Google

# Session Configuration
SESSION_SECRET=your_session_secret
SESSION_COOKIE_NAME=session_cookie
SESSION_COOKIE_MAX_AGE=3600000
COOKIE_DOMAIN=localhost

# Email Configuration
EMAIL_USER=your_email@example.com
APP_EMAIL_PASSWORD=your_app_password
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true

# Storage Configuration
## AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
AWS_BUCKET_NAME=your_bucket_name

## Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER_NAME=your_container_name
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key

## Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

## Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON=your_anon_key
SUPABASE_BUCKET_NAME=your_bucket_name
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
FILE_UPLOAD_PATH=uploads/
MAX_REQUEST_SIZE=10485760

# Security Configuration
SECURE_COOKIES=true
CSP_REPORT_URI=https://your-reporting-endpoint.com/csp-reports
TRUSTED_DOMAINS=yourfrontend.com,api.yourbackend.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourfrontend.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSE_HEADERS=Content-Range,X-Content-Range
CORS_MAX_AGE=86400

# Security Headers Configuration
SECURITY_HEADERS_AUDIT=true
SECURITY_MAX_AGE=31536000
XSS_PROTECTION_MODE=block
FRAME_ANCESTORS=none
REFERRER_POLICY=strict-origin-when-cross-origin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Queue Configuration
QUEUE_CONCURRENCY=1
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF=5000

# Docker Configuration
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password